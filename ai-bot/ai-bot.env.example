# Auto-reply bot configuration — copy to ai-bot.env and fill in (systemd reads it)
# 1) paste your Google AI Studio key after GEMINI_API_KEY=
# 2) replace __HOME__ with your real home path (install.sh does this from the example)
# 3) systemctl --user restart openwa-ai-bot
GEMINI_API_KEY=__PASTE_YOUR_GEMINI_KEY__
# Primary model, with an automatic fallback (free-tier buckets are per model —
# when the primary's daily quota runs out, the fallback answers for the day)
GEMINI_MODEL=gemini-3.5-flash-lite
# 1 = auto-discover EVERY chat-capable Gemini model on your key (lites first,
# newest first) and walk it one-by-one: drain a model's daily RPD bucket, then
# stick on the next (cursor survives restarts, wraps when everything's dry).
GEMINI_AUTO_CHAIN=1
# 1 = at every start the bot probes each discovered model once and benches the
# gated/dead ones ("limit: 0", 'not available to new users') for 24 h —
# re-probed on restart, so a model that comes back joins the chain again.
GEMINI_SELFTEST=1
# Manual safety net — only used if discovery fails or GEMINI_AUTO_CHAIN=0.
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-2.5-flash,gemini-2.5-flash-lite

OPENWA_URL=http://localhost:2785/api
OPENWA_KEY_FILE=__HOME__/openwa/.ai-agent-key
SESSION_ID_FILE=__HOME__/openwa/reminders/session-id

POLL_SECONDS=6
REPLY_COOLDOWN_SECONDS=45
# Answer messages up to 60 min old (survives PC sleep between message and wake)
STALE_SECONDS=3600
# 1 = also auto-answer messages in the @g.us group chats (default: DMs only)
ANSWER_GROUPS=0
